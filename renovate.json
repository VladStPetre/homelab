{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],

  "timezone": "Europe/Bucharest",
  "schedule": ["on the 2nd day of the month"],

  "enabledManagers": ["docker-compose"],
  "docker-compose": {
    "managerFilePatterns": ["/(^|/)docker-stack\\.ya?ml$/"]
  },
  "dependencyDashboard": true,
  "rebaseWhen": "behind-base-branch",

  "packageRules": [
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["stacks/*/**"],

      "groupName": "stack: {{parentDir}}",
      "groupSlug": "stack-{{parentDir}}",

      "separateMajorMinor": false,
      "separateMinorPatch": false,

      "semanticCommits": "enabled",
      "semanticCommitType": "chore",
      "semanticCommitScope": "stack/{{parentDir}}",
      "commitMessageTopic": "monthly dependency updates for stack/{{parentDir}}",
      "commitMessageAction": "Update",
      "labels": ["dependencies", "renovate", "stack"],
      "prBodyNotes": [
        "This PR groups all Docker image updates found under `{{packageFileDir}}`."
      ]
    },
    {
      "description": "Parse Hotio Arr release tags correctly",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/hotio/sonarr",
        "ghcr.io/hotio/radarr",
        "ghcr.io/hotio/bazarr",
        "ghcr.io/hotio/prowlarr"
      ],
      "versioning": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    },
    {
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchDepNames": ["ghcr.io/immich-app/postgres"],
      "allowedVersions": "14.x"
    },
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["stacks/authentik/**"],
      "matchDatasources": ["docker"],
      "matchDepNames": ["docker.io/library/postgres"],
      "allowedVersions": "/^16/"
    },
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["stacks/arr/**"],
      "matchDatasources": ["docker"],
      "matchDepNames": ["lscr.io/linuxserver/qbittorrent"],
      "description": "Disable Renovate updates for qbittorrent in the arr stack (managed elsewhere).",
      "enabled": false
    }
  ]
 }
